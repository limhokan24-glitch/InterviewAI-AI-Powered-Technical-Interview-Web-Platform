# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (SQLite for zero-config dev; swap to a Postgres URL for production)
DATABASE_URL="file:./dev.db"

# AI provider (optional). If unset, the server uses a built-in deterministic
# fallback so everything runs without an API key.
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-6
