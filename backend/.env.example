# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (SQLite for zero-config dev; swap to a Postgres URL for production)
DATABASE_URL="file:./dev.db"

# AI provider (optional). The first key set wins; if none, the server uses a
# built-in deterministic fallback so everything runs without an API key.
#
# Groq — FREE, no credit card, works in most regions. Get a key:
#   https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
#
# Google Gemini — free tier, but blocked in some regions:
# GEMINI_API_KEY=AQ... or AIza...
GEMINI_MODEL=gemini-2.0-flash
#
# Anthropic (paid):
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-6
