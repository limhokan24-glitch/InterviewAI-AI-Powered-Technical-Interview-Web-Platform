# ── Frontend service configuration ───────────────────────────────────────────
# Copy this file to `.env` and adjust as needed.

# When true (default), the app serves mock data and a simulated WebSocket so the
# frontend runs fully standalone. Set to false once the backend is ready.
VITE_USE_MOCKS=true

# Backend REST + WebSocket endpoints (used when VITE_USE_MOCKS=false).
VITE_API_BASE_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000/ws
